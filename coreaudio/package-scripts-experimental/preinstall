#!/bin/zsh
set -eu

APP_SUPPORT="/Library/Application Support/Numark NS6/rollback-previous"
OLD_AGENT="/Library/LaunchAgents/io.github.maurojuniorr.numark-ns6-midi-bridge.plist"
NEW_AGENT="/Library/LaunchAgents/io.github.maurojuniorr.numark-ns6-device-service.plist"
OLD_DRIVER="/Library/Audio/Plug-Ins/HAL/NumarkNS6M1.driver"
STATUS_APP="/Applications/Numark NS6 Status.app"
CONSOLE_UID=$(/usr/bin/stat -f '%u' /dev/console)

# Refuse a login-window install before changing any existing files or services.
if [[ "$CONSOLE_UID" == "0" ]]; then
    print -u2 'No logged-in GUI user; existing NS6 installation was left untouched.'
    exit 1
fi

/bin/rm -rf "$APP_SUPPORT"
/bin/mkdir -p "$APP_SUPPORT"
if [[ -d "$OLD_DRIVER" ]]; then
    /usr/bin/ditto "$OLD_DRIVER" "$APP_SUPPORT/NumarkNS6M1.driver"
    /usr/bin/touch "$APP_SUPPORT/had-driver"
fi
if [[ -d "$STATUS_APP" ]]; then
    /usr/bin/ditto "$STATUS_APP" "$APP_SUPPORT/Numark NS6 Status.app"
    /usr/bin/touch "$APP_SUPPORT/had-status-app"
fi
if [[ -f "$OLD_AGENT" ]]; then
    /bin/cp "$OLD_AGENT" "$APP_SUPPORT/numark-ns6-midi-bridge.plist"
    /usr/bin/touch "$APP_SUPPORT/had-midi-agent"
fi
if [[ -f "$NEW_AGENT" ]]; then
    /bin/cp "$NEW_AGENT" "$APP_SUPPORT/numark-ns6-device-service.plist"
    /usr/bin/touch "$APP_SUPPORT/had-device-service-agent"
fi
/bin/launchctl bootout "gui/$CONSOLE_UID" "$NEW_AGENT" >/dev/null 2>&1 || true
/bin/launchctl bootout "gui/$CONSOLE_UID" "$OLD_AGENT" >/dev/null 2>&1 || true
/bin/rm -f "$OLD_AGENT"
/usr/bin/killall NumarkNS6MIDIBridge NumarkNS6DeviceService >/dev/null 2>&1 || true
exit 0
