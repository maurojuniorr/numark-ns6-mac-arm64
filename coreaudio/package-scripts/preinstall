#!/bin/zsh
set -eu

# Unload the previous per-user bridge so the upgrade can replace its app bundle.
CONSOLE_UID=$(/usr/bin/stat -f '%u' /dev/console 2>/dev/null || echo 0)
if [[ "$CONSOLE_UID" =~ '^[1-9][0-9]*$' ]]; then
    /bin/launchctl bootout "gui/$CONSOLE_UID/io.github.maurojuniorr.numark-ns6-midi-bridge" >/dev/null 2>&1 || true
fi

# Remove only the legacy copy; Installer atomically replaces the standard app bundle.
/bin/rm -rf "/Applications/Numark NS6 Status.localized/Numark NS6 Status.app"
exit 0
